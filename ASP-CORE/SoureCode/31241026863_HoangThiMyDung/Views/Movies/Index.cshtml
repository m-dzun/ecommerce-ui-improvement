
@model IEnumerable<_31241026863_HoangThiMyDung.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h2>31241026863 - Hoang Thi My Dung</h2>

<div class="container">
    <div class="row grid-demo">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">

                <img src="@item.PicturePath"
                     alt="@item.Title"
                     style="width: 200px;" />

                <p>
                    @Html.DisplayNameFor(model => model.Title):
                    @Html.DisplayFor(modelItem => item.Title)
                </p>

                <p>
                    @Html.DisplayNameFor(model => model.Rated):
                    @Html.DisplayFor(modelItem => item.Rated)
                </p>

                <p>
                    @Html.DisplayNameFor(model => model.Price):
                    @Html.DisplayFor(modelItem => item.Price)
                </p>

                <p>
                    @Html.DisplayNameFor(model => model.Summary):
                    @Html.DisplayFor(modelItem => item.Summary)
                </p>

                <p>
                    @Html.DisplayNameFor(model => model.ReleaseDate):
                    @item.ReleaseDate.ToString("dd/MM/yyyy")
                </p>

                <p>
                    @Html.DisplayNameFor(model => model.Genre):
                    @(item.GenreObj?.Name ?? "Chưa có thể loại")
                </p>

                <a class="btn btn-primary"
                   asp-action="AddToCart"
                   asp-route-id="@item.ID">
                    Mua
                </a>

            </div>
        }

    </div>
</div>
